{
  "manifest_version": 3,
  "name": "Кладоискатель для Годвилля",
  "version": "1.25.1",
  "description": "Кладоискатель: термокандидаты, совет на один ход, режим аквариума и архив карт.",
  "content_scripts": [
    {
      "matches": [
        "https://godville.net/*",
        "https://*.godville.net/*",
        "https://godvillegame.com/*",
        "https://*.godvillegame.com/*",
        "https://gv.erinome.net/duels/log/*",
        "https://gvg.erinome.net/duels/log/*",
        "https://gv.erinome.net/reporter/duels/log/*",
        "https://gvg.erinome.net/reporter/duels/log/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "controls.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
